# Copy to .env.local (never commit real values).

# Super Market (SIG Predictions Cup) API key: Settings -> API Keys. `read` scope is enough;
# this project only paper trades and never places orders.
SIG_API_KEY=
SIG_API_BASE=https://sig.thesuper.market/api/v1
SIG_TOURNAMENT_SLUG=midterm-elections

# Published limits: 100 reads / 30 writes per minute per key. The bot uses 85% of the read budget.
SIG_READS_PER_MIN=100
SIG_RATE_SAFETY=0.85
# Fast loop for "hot" markets (positions, arbitrage races, live signals): 1 read per tick.
PRICE_POLL_SEC=2
# Whole-universe top of book (3 reads for 237 markets).
UNIVERSE_POLL_SEC=6
HOT_DEPTH_MAX_AGE_SEC=10
DEPTH_CONCURRENCY=4
SIG_TIMEOUT_MS=8000
EXTERNAL_POLL_SEC=90
NEWS_MARKETS_PER_MIN=12

INITIAL_BANKROLL=100000
DB_PATH=./data/predictioncup.db
LOG_LEVEL=INFO

# Optional: require `x-bot-token` on start/stop/reset endpoints (set this on any public host).
BOT_ADMIN_TOKEN=
# Optional, read-only: enables GET /api/export/db (gzipped database download) with header
# `x-export-token`. Grants no control over the bot. Leave empty to disable.
BOT_EXPORT_TOKEN=

# Vercel only (Day 2): URL of the long-running bot backend that stateful API calls proxy to.
BOT_BACKEND_URL=

# Reserved for future authenticated features; public market data needs neither.
POLYMARKET_API_KEY=
KALSHI_API_KEY_ID=
